595890990,"text":"保持事物质性质的边界"},"children":[]},{"data":{"id":"dmam7ry7zxc0","created":1792595909007,"text":"度的两端"},"children":[{"data":{"id":"dmam7ulqjmw0","created":1792595914782,"text":"关节点"},"children":[]},{"data":{"id":"dmam7wzkxe80","created":1792595919973,"text":"临界点"},"children":[]}]}]},{"data":{"id":"dmam3bc8tk80","created":1792595559394,"text":"量变一定会引起质变"},"children":[{"data":{"id":"dmam3gntwu80","created":1792595570977,"text":"水滴一定会石穿"},"children":[]}]},{"data":{"id":"dmam8ywz4ag0","created":1792596002533,"text":"量变和质变的辨证关系"},"children":[{"data":{"id":"dmam92up05k0","created":1792596011102,"text":"相互联系"},"children":[{"data":{"id":"dmam9b5yw540","created":1792596029198,"text":"量变"},"children":[{"data":{"id":"dmam9ehyhc00","created":1792596036453,"text":"质变的准备"},"children":[]},{"data":{"id":"dmama5gyo680","created":1792596095166,"text":"量变的过程中也会有局部的质变"},"children":[]}]},{"data":{"id":"dmam9odhrrk0","created":1792596057951,"text":"质变"},"children":[{"data":{"id":"dmam9q224eo0","created":1792596061613,"text":"量变的必然结果"},"children":[]}]}]}]},{"data":{"id":"dmamaej87fc0","created":1792596114894,"text":"方法论意义"},"children":[{"data":{"id":"dmamag3z84g0","created":1792596118326,"text":"量变阶段,要踏踏实实"},"children":[]},{"data":{"id":"dmamaowynug0","created":1792596137493,"text":"质变来临,要抓住机会"},"children":[]}]}]},{"data":{"id":"dmamb10rnow0","created":1792596163844,"text":"否定之否定"},"children":[{"data":{"id":"dmamb6pqp480","created":1792596176238,"text":"肯定因素和否定因素"},"children":[{"data":{"id":"dmambazzpgg0","created":1792596185565,"text":"肯定因素"},"children":[{"data":{"id":"dmambcwe7r40","created":1792596189701,"text":"你现在还活着的原因,一个婴儿,肯定因素占主导"},"children":[]}]},{"data":{"id":"dmambj3geyw0","created":1792596203189,"text":"否定因素"},"children":[{"data":{"id":"dmambm7wrow0","created":1792596209988,"text":"你终将会死的原因,一个老人,否定因素占主导"},"children":[]}]},{"data":{"id":"dmamcm9tf3k0","created":1792596288468,"text":"否定观的内容"},"children":[{"data":{"id":"dmamcskzr880","created":1792596302204,"text":"否定是