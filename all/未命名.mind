物已经适应了环境和条件"},"children":[]},{"data":{"id":"dmajzmnj1lk0","created":1792589628343,"text":"新事物是由旧事物孕育而出的"},"children":[]}]},{"data":{"id":"dmak0yalelc0","created":1792589732046,"text":"方法论意义"},"children":[{"data":{"id":"dmak138e5k00","created":1792589742797,"text":"要用历史眼光看问题"},"children":[]}]}]}]},{"data":{"id":"dmak1dgocps0","created":1792589765066,"text":"三大规律"},"children":[{"data":{"id":"dmak26v29uo0","created":1792589829062,"text":"对立统一规律(矛盾规律)(唯物辩证法第一规律)"},"children":[{"data":{"id":"dmam01p0tjc0","created":1792595303305,"text":"唯物辩证法的实质.核心"},"children":[]},{"data":{"id":"dmak2nfhrqw0","created":1792589865126,"text":"矛盾"},"children":[{"data":{"id":"dmak2owrnt40","created":1792589868348,"text":"上和下,强和弱都是矛盾,矛盾不是贬义词"},"children":[]},{"data":{"id":"dmak36cqiaw0","created":1792589906318,"text":"矛盾=对立统一"},"children":[]}]},{"data":{"id":"dmak3q24f740","created":1792589949212,"text":"矛盾特性"},"children":[{"data":{"id":"dmak3sy22hs0","created":1792589955497,"text":"同一性"},"children":[{"data":{"id":"dmak45nw1u80","created":1792589983180,"text":"相互依存"},"children":[{"data":{"id":"dmak47vrwk80","created":1792589988011,"text":"没有上就没有下,没有强就没有弱,没有学生就没有老师"},"children":[]}]},{"data":{"id":"dmak4nht12w0","created":1792590021995,"text":"矛盾双方一定条件下可以相互转化"},"children":[{"data":{"id":"dmak4xe9km80","created":1792590043548,"text":"我现在很弱,但是如果遇到比我还弱的人,那我就是强的"},"children":[]}]},{"data":{"id":"dmak91hqc3s0","created":1792590365922,"text":"包含斗争性,通过斗争性来体现"},"children":[{"data":{"id":"dmak97m0nvk0","created":1792590379242,"text":"注意:两者是包含和被包含的关系,寓于和包含不能颠倒"},"children":[]}]}]},{"data":{"id":"dmak3w68ow80","created":1792589962522,"text":"斗争性"},"children":[{"data":{"id":"dmak5nygd3c0","created":1792590101365,"text":"对抗性矛盾"},"children":[{"data":{"id":"dmak9orm5jc0","created":1792590416585,"text":"2人竞争一个岗位"},"children":[]}]},{"data":{"id":"dmak5qmlv3k0","created":1792590107179,"text":"非对抗性矛盾"},"children":[]},{"data":{"id":"dmak67rtvqo0","created":1792590144500,"text":"寓与同一性中"},"children":[{"data":{"id":"dmak6e88ag80","created":1792590158553,"text":"有两个捡破烂的人,当一个人看到有个富豪开着豪车经过,完全不羡慕嫉妒,但是当看到另一个捡破烂的人捡得比自己多,那么就嫉妒了,2个捡破烂的人具有同一性,导致了他们的斗争性"},"children":[]}]}]}]},{"data":{"id":"dmakamsld0g0","created":1792590490655,"text":"同一性和斗争性在事物中发挥的作用"},"children":[{"data":{"id":"dmakba08gy80","created":1792590541183,"text":"同一"},"children":[{"data":{"id":"dmakbbgq43s0","created":1792590544357,"text":"矛盾双方相互依存,可以利用对方发展使自己发展"},"children":[{"data":{"id":"dmakbv4cdhs0","created":1792590587144,"text":"学生出息了,老师脸上有光"},"children":[]}]},{"data":{"id":"dmakc8s3ug00","created":1792590616879,"text":"相互吸收对方有利于自身的因素"},"children":[]},{"data":{"id":"dmakcfbc9wg0","created":1792590631103,"text":"都可以向着彼此的对立面转化而发展"},"children":[]}]},{"data":{"id":"dmakcu1vmi80","created":1792590663182,"text":"斗争"},"children":[{"data":{"id":"dmakd6hr6g00","created":1792590690264,"text":"促进双方力量变化,造成事物量变"},"children":[]},{"data":{"id":"dmakdp2dwpk0","created":1792590730693,"text":"使双方地位和性质发生变化,实现质变"},"children":[]}]},{"data":{"id":"dmakf09gr5c0","created":1792590833430,"text":"方法论意义(夫妻吵架)"},"children":[{"data":{"id":"dmakf45e52o0","created":1792590841891,"text":"相辅相成(同一)(有的越吵感情越好"},"children":[]},{"data":{"id":"dmakfawvm000","created":1792590856613,"text":"相反相成(斗争)(有的越吵感情越差"},"children":[]}]}]},{"data":{"id":"dmalohxcw680","created":1792594398267,"text":"矛盾普遍性和特殊性的辨证关系"},"children":[{"data":{"id":"dmalopu9x800","created":1792594415495,"text":"普遍性和特殊性"},"children":[{"data":{"id":"dmalp6ukxr40","created":1792594452519,"text":"辨证统一"},"children":[]},{"data":{"id":"dmalpdqz1i80","created":1792594467538,"text":"普遍性:共性"},"children":[{"data":{"id":"dmalpth797s0","created":1792594501776,"text":"寓与个性中"},"children":[]}]},{"data":{"id":"dmalpg1s9js0","created":1792594472546,"text":"特殊性:个性"},"children":[{"data":{"id":"dmalppkqrf40","created":1792594493283,"text":"有条件的.相对的"},"children":[]}]}]},{"data":{"id":"dmalqd370bk0","created":1792594544465,"text":"方法论意义"},"children":[{"data":{"id":"dmalqmkat940","created":1792594565090,"text":"人的